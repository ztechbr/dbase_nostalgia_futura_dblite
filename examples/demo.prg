* Execute apenas em diretório vazio. CREATE não sobrescreve bancos.
CREATE clientes (NOME C 40, IDADE N 3, SALDO N 12 2, ATIVO L 1)
APPEND BLANK
REPLACE NOME WITH 'BODEZARONI', IDADE WITH 52, SALDO WITH 1500.50, ATIVO WITH .T.
APPEND BLANK
REPLACE NOME WITH 'KELLY', IDADE WITH 45, SALDO WITH 2500, ATIVO WITH .T.
GO TOP
DISPLAY
LIST ALL FOR SALDO > 1000
INDEX ON NOME TO nomes
SEEK 'KELLY'
DISPLAY
STORE 0 TO TOTAL
GO TOP
DO WHILE .NOT. EOF()
STORE TOTAL + SALDO TO TOTAL
SKIP
ENDDO
? TOTAL
GO TOP
DELETE
SET DELETED ON
LIST ALL
SET DELETED OFF
GO TOP
RECALL
COUNT
COPY TO clientes_exportados DELIMITED
